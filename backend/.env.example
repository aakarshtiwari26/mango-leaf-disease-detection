# MongoDB Atlas connection string — from Atlas UI: Database > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=mango_leaf

# ImageKit — from the ImageKit dashboard: Developer Options
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Inference thresholds — overridden at runtime by values baked into backend/app/ml/labels.json
# if present; these are the fallback defaults.
CONFIDENCE_THRESHOLD=0.65
GATE_THRESHOLD=0.5
